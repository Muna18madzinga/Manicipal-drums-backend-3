# Production environment template — copy to the host as secrets (never commit).
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

NODE_ENV=production
PORT=3000

# Owner connection — migrations / create-runtime-role only (not the app pool).
DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/vungu_master_db_v1

# Runtime login — created by: node scripts/create-runtime-role.js --apply
# server.js loads .env.runtime automatically; or set APP_DATABASE_URL here.
# APP_DATABASE_URL=postgresql://vungu_runtime:...@127.0.0.1:5432/vungu_master_db_v1

# Refuse to boot as postgres superuser unless you intentionally set:
# ALLOW_SUPERUSER_DB=1

JWT_SECRET=replace-with-48-byte-random-base64-secret
COOKIE_SECRET=replace-with-another-48-byte-random-base64-secret

# Cloudflare Turnstile (required in production)
TURNSTILE_SECRET_KEY=0x...
# Frontend needs the matching site key as VITE_TURNSTILE_SITE_KEY

# Demo @vungu.test one-click logins are BLOCKED when NODE_ENV=production.
# Never set ALLOW_DEMO_LOGIN=1 on a public host.
ALLOW_DEMO_LOGIN=0

ALLOWED_ORIGINS=https://portal.vungurdc.gov.zw
FRONTEND_URL=https://portal.vungurdc.gov.zw

# Paynow production merchant credentials
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_API_BASE=https://www.paynow.co.zw
PAYNOW_RESULT_URL=https://api.vungurdc.gov.zw/api/payments/webhook/paynow
PAYNOW_RETURN_URL=https://portal.vungurdc.gov.zw/payment/return

MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vungurdc.gov.zw

TENANCY_MODE=strict
